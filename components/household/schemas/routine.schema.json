{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "anchor",
    "timezone",
    "window_minutes",
    "full_steps",
    "minimum_steps",
    "max_nudges",
    "quiet_start",
    "quiet_end",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "quiet_start": {
      "type": "string"
    },
    "quiet_end": {
      "type": "string"
    },
    "wall_time": {
      "type": "string"
    },
    "first_due": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "anchor": {
      "enum": [
        "clock",
        "completion",
        "event"
      ]
    },
    "kind": {
      "const": "ordinary"
    },
    "window_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "max_nudges": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "fold": {
      "enum": [
        0,
        1
      ]
    },
    "gap": {
      "enum": [
        "shift_forward",
        "reject"
      ]
    },
    "interval": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "interval_semantics": {
      "enum": [
        "elapsed_hours",
        "calendar_days"
      ]
    },
    "full_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "minimum_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$comment": "Anchor-specific fields and minimum-subset/version constraints are enforced in configure_routine; samples do not establish authority."
}
